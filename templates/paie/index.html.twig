{% extends 'base.html.twig' %}
{% block title %}Salaires et primes{% endblock %}
{% block content %}
<header class="page-head"><div><h1>Salaires et primes</h1></div><a class="btn" href="{{ path('paie_new') }}"><i class="bi bi-plus"></i> Nouveau bulletin</a></header>
<div class="stats three">
    <div class="stat peach"><img src="{{ asset('img/icon_coin.png') }}" alt=""><div><b>{{ count }}</b><span>Bulletins de paie</span></div></div>
    <div class="stat mint"><img src="{{ asset('img/icon_report.png') }}" alt=""><div><b>{{ mass|number_format(0, ',', ' ') }} €</b><span>Masse salariale</span></div></div>
    <div class="stat green"><img src="{{ asset('img/icon_gift.png') }}" alt=""><div><b>{{ bonuses }}</b><span>Primes ce mois</span></div></div>
</div>
<section class="card"><h2>Bulletins de paie récents</h2>
{% if bulletins %}<table><thead><tr><th>Employé</th><th>Période</th><th>Base</th><th>Prime</th><th>Total</th></tr></thead><tbody>
{% for b in bulletins %}<tr><td><span class="who"><img src="{{ asset('img/' ~ b.employee.avatar) }}" alt=""><b>{{ b.employee.fullName }}</b></span></td>
<td>{{ b.period }}</td><td>{{ b.baseSalary|number_format(2, ',', ' ') }} €</td><td>{{ b.bonus|number_format(2, ',', ' ') }} €</td><td><b>{{ b.total|number_format(2, ',', ' ') }} €</b></td></tr>{% endfor %}
</tbody></table>{% else %}<div class="empty"><img src="{{ asset('img/ill_payroll.png') }}" alt=""><p>Aucun bulletin.</p></div>{% endif %}
</section>
{% endblock %}

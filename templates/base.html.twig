<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Teamora{% endblock %} · Teamora RH</title>
    <link rel="icon" href="{{ asset('img/icon_portal.png') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body>
{% block body %}
{% set route = app.request.attributes.get('_route') ?? '' %}
<div class="layout">
    <aside class="sidebar">
        <a href="{{ path('app_dashboard') }}"><img class="logo" src="{{ asset('img/logo.png') }}" alt="Teamora"></a>
        <nav>
            <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' }}"><i class="bi bi-house"></i> Tableau de bord</a>
            <a href="{{ path('employee_index') }}" class="{{ route starts with 'employee' ? 'active' }}"><i class="bi bi-people"></i> Employés</a>
            <a href="{{ path('department_index') }}" class="{{ route starts with 'department' ? 'active' }}"><i class="bi bi-diagram-3"></i> Départements</a>
            <a href="{{ path('leave_index') }}" class="{{ route starts with 'leave' ? 'active' }}"><i class="bi bi-calendar-check"></i> Congés et absences</a>
            <a href="{{ path('paie_index') }}" class="{{ route starts with 'paie' ? 'active' }}"><i class="bi bi-cash-coin"></i> Salaires et primes</a>
        </nav>
        <div class="me">
            <img src="{{ asset('img/avatar_hr.png') }}" alt="">
            <div><strong>{{ app.user.fullName }}</strong><small>Responsable RH</small></div>
            <a href="{{ path('app_logout') }}" title="Déconnexion"><i class="bi bi-box-arrow-right"></i></a>
        </div>
    </aside>
    <main>
        {% for type, msgs in app.flashes %}{% for m in msgs %}<div class="flash {{ type }}">{{ m }}</div>{% endfor %}{% endfor %}
        {% block content %}{% endblock %}
    </main>
</div>
{% endblock %}
</body>
</html>

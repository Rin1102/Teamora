{% extends 'base.html.twig' %}
{% block title %}Gestion des congés{% endblock %}
{% block content %}
<header class="page-head"><div><h1>Gestion des congés</h1><p class="muted">{{ count }} congé(s) enregistré(s)</p></div><a class="btn" href="{{ path('leave_new') }}"><i class="bi bi-plus"></i> Enregistrer un congé</a></header>
<section class="card">
{% if leaves %}
<table><thead><tr><th>Employé</th><th>Type</th><th>Période</th><th>Jours</th><th>Solde</th><th>Retenue</th><th>Solde restant</th></tr></thead><tbody>
{% for l in leaves %}<tr>
<td><span class="who"><img src="{{ asset('img/' ~ l.employee.avatar) }}" alt=""><b>{{ l.employee.fullName }}</b></span></td>
<td>{{ l.type }}</td>
<td>{{ l.startDate|date('d/m/Y') }} – {{ l.endDate|date('d/m/Y') }}</td>
<td>{{ l.days }}</td>
<td><span class="badge {{ l.paid ? 'ok' : 'warn' }}">{{ l.paid ? 'Avec solde' : 'Avec retenue' }}</span></td>
<td>{{ l.salaryDeduction|number_format(3, ',', ' ') }} DT</td>
<td><b>{{ l.employee.leaveBalance }} jour(s)</b></td>
</tr>{% endfor %}</tbody></table>
{% else %}<div class="empty"><img src="{{ asset('img/ill_vacation.png') }}" alt=""><p>Aucun congé enregistré.</p></div>{% endif %}
</section>
{% endblock %}
